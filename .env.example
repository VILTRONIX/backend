PORT=5000
NODE_ENV=development
MONGODB_URI=
CLIENT_URL=http://localhost:5173
# Optional read-only Engine integration. Set absolute local paths in the process environment.
# TERRAPULSE_ENGINE_ROOT=C:/path/to/engine
# Features and schemas default beneath ENGINE_ROOT, or the Backend repository if it is unset.
# TERRAPULSE_FEATURES_ROOT=
# TERRAPULSE_SCHEMAS_ROOT=
# Leave overrides unset when using defaults. TERRAPULSE_DATA_ROOT keeps its existing meaning.
